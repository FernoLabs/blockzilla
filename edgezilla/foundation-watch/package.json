{
  "name": "blockzilla-foundation-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "pretest": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
