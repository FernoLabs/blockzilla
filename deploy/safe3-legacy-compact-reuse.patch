+fn legacy_compact_admission_blocked_reason(
+    config: &NasPipelineConfig,
+    machine: &MachineSnapshot,
+    epoch: &EpochSnapshot,
+) -> Option<String> {
+    let disk_reserve = config.disk_reserve_gib.saturating_mul(1024 * 1024 * 1024);
+    let projected_disk = scan_remaining_disk_projection(epoch);
+    if machine.disk_total_bytes == 0
+        || machine.disk_available_bytes < disk_reserve.saturating_add(projected_disk)
+    {
+        return Some(format!(
+            "legacy compact/reuse disk admission blocked: available {:.1} GiB, projected output {:.1} GiB, reserve {} GiB",
+            machine.disk_available_bytes as f64 / 1024f64.powi(3),
+            projected_disk as f64 / 1024f64.powi(3),
+            config.disk_reserve_gib,
+        ));
+    }
+    if machine.memory_total_bytes == 0 {
+        return Some(
+            "legacy compact/reuse memory admission blocked: memory capacity unavailable"
+                .to_string(),
+        );
+    }
+    let reserve = config.memory_reserve_mib.saturating_mul(1024 * 1024);
+    let estimate = LEGACY_COMPACT_MEMORY_MIB.saturating_mul(1024 * 1024);
+    (machine.memory_available_bytes < reserve.saturating_add(estimate)).then(|| {
+        format!(
+            "legacy compact/reuse memory admission blocked: available {:.1} MiB, estimate {} MiB, reserve {} MiB",
+            machine.memory_available_bytes as f64 / 1024f64.powi(2),
+            LEGACY_COMPACT_MEMORY_MIB,
+            config.memory_reserve_mib,
+        )
+    })
+}
