+fn merge_live_journal_progress(
+    progress: &mut ProgressSnapshot,
+    journal: Option<&Value>,
+    journal_updated_unix_secs: Option<u64>,
+) {
+    let Some(row) = journal else {
+        return;
+    };
+    if progress.first_slot.is_none() {
+        progress.first_slot = json_u64(row, &["first_slot"]);
+    }
+    if let Some(last_slot) = json_u64(row, &["slot", "last_slot"]) {
+        progress.last_slot = Some(
+            progress
+                .last_slot
+                .map_or(last_slot, |snapshot_slot| snapshot_slot.max(last_slot)),
+        );
+    }
+    if let Some(blocks_done) =
+        json_u64(row, &["block_id"]).map(|block_id| block_id.saturating_add(1))
+    {
+        progress.blocks_done = progress.blocks_done.max(blocks_done);
+    }
+    if let Some(journal_updated) = journal_updated_unix_secs {
+        progress.updated_unix_secs = Some(
+            progress
+                .updated_unix_secs
+                .map_or(journal_updated, |snapshot_updated| {
+                    snapshot_updated.max(journal_updated)
+                }),
+        );
+    }
+}
