[Unit]
Description=Blockzilla verified predecessor-tail discovery
After=blockzilla-archive.service
ConditionPathExists=/usr/local/bin/blockzilla

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0022
ExecStartPre=/usr/bin/test -x /usr/local/bin/blockzilla
ExecStart=/usr/local/bin/blockzilla seed-previous-blockhash-tails --archive-root /srv/blockzilla/archive-v2 --discover --start-epoch 713 --end-epoch 799 --receipt-dir /var/lib/blockzilla/tail-seed-receipts
StandardOutput=journal
StandardError=journal
