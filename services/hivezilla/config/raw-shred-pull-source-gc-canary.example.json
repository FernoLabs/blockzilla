{
  "schema_version": 1,
  "bind": "127.0.0.1:19443",
  "tls": {
    "server_certificate_file": "/run/secrets/hivezilla_shred_pull_server_certificate",
    "server_private_key_file": "/run/secrets/hivezilla_shred_pull_server_private_key",
    "client_ca_file": "/run/secrets/hivezilla_shred_pull_client_ca",
    "handshake_timeout_ms": 10000
  },
  "allowed_nodes_file": "/run/secrets/hivezilla_shred_pull_allowed_nodes",
  "spool_root": "/data/shred-ingest",
  "cluster_id": "solana-mainnet",
  "origin_node_id": "hivezilla-shred-gc-canary",
  "source_id": "shred-reader-gc-canary",
  "journal_id": "__GC_CANARY_JOURNAL_ID__",
  "recorder_status_file": "/status/gc-canary-recorder.json",
  "cumulative_ack_wal_file": "/control/gc-canary-ack.wal",
  "ack_status_file": "/control/gc-canary-ack-status.json",
  "expected_primary_id": "blockzilla-gc-canary",
  "trusted_receipt_keys": [
    {
      "key_id": "gc-canary-receipt",
      "public_key_file": "/run/secrets/hivezilla_shred_pull_receipt_public_key"
    }
  ],
  "gc": {
    "enabled": true,
    "control_uid": 0,
    "recorder_gid": 10001,
    "max_retirements_per_process": 1
  },
  "limits": {
    "max_records": 256,
    "max_batch_compressed_bytes": 1048576,
    "max_batch_uncompressed_bytes": 1048576,
    "max_compressed_record_bytes": 4096,
    "max_uncompressed_record_bytes": 4096
  }
}
