{
  "schema_version": 1,
  "bind": "0.0.0.0:18443",
  "tls": {
    "server_certificate_file": "/etc/hivezilla/tls/hetzner.crt",
    "server_private_key_file": "/run/secrets/hetzner-pull-server-key.pem",
    "client_ca_file": "/etc/hivezilla/tls/nas-client-ca.crt",
    "handshake_timeout_ms": 10000
  },
  "allowed_nodes_file": "/etc/hivezilla/replication/allowed-nodes.json",
  "spool_root": "/data/shred-ingest",
  "cluster_id": "solana-mainnet",
  "origin_node_id": "hivezilla-shred-01",
  "source_id": "shred-reader-loopback",
  "journal_id": "__SHRED_JOURNAL_ID__",
  "recorder_status_file": "/status/recorder.json",
  "cumulative_ack_wal_file": "/control/nas-shred-ack.wal",
  "ack_status_file": "/control/nas-shred-ack-status.json",
  "expected_primary_id": "blockzilla-nas",
  "trusted_receipt_keys": [
    {
      "key_id": "nas-receipt-current",
      "public_key_file": "/etc/hivezilla/receipts/nas-receipt-current.pub"
    }
  ],
  "limits": {
    "max_records": 256,
    "max_batch_compressed_bytes": 1048576,
    "max_batch_uncompressed_bytes": 1048576,
    "max_compressed_record_bytes": 4096,
    "max_uncompressed_record_bytes": 4096
  }
}
