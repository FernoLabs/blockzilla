{
  "source": {
    "protocol": "v2",
    "endpoint": "https://hivezilla-ingest.example.net:18443",
    "tls": {
      "ca_file": "/etc/hivezilla/tls/hetzner-ca.crt",
      "client_certificate_file": "/etc/hivezilla/tls/nas-client.crt",
      "client_private_key_file": "/run/secrets/nas-pull-client-key.pem",
      "server_name": "hivezilla-ingest.example.net"
    },
    "connect_timeout_ms": 5000,
    "request_timeout_ms": 30000,
    "stream_idle_timeout_ms": 60000,
    "batch": {
      "max_events": 256,
      "max_bytes": 1048576,
      "max_uncompressed_bytes": 1048576,
      "max_compressed_event_bytes": 4096,
      "max_uncompressed_event_bytes": 4096
    }
  },
  "local_sink": {
    "endpoint": "https://127.0.0.1:9443",
    "expected_primary_id": "blockzilla-nas",
    "cumulative_ack_wal_file": "/control/local-sink-ack.wal",
    "tls": {
      "ca_file": "/etc/hivezilla/tls/nas-receiver-ca.crt",
      "client_certificate_file": "/etc/hivezilla/tls/nas-pull-client.crt",
      "client_private_key_file": "/run/secrets/nas-local-sink-key.pem",
      "server_name": "blockzilla-nas"
    },
    "auth": {
      "method": "mutual_tls"
    },
    "trusted_receipt_keys": [
      {
        "key_id": "nas-receipt-current",
        "public_key_file": "/etc/hivezilla/receipts/nas-receipt-current.pub"
      }
    ],
    "reconnect": {
      "initial_delay_ms": 500,
      "max_delay_ms": 30000,
      "backoff_factor_milli": 2000,
      "jitter_percent": 20,
      "connect_timeout_ms": 5000,
      "heartbeat_interval_ms": 15000,
      "idle_timeout_ms": 60000,
      "max_attempts": null
    },
    "batch": {
      "max_events": 256,
      "max_bytes": 1048576,
      "max_uncompressed_bytes": 1048576,
      "max_compressed_event_bytes": 4096,
      "max_uncompressed_event_bytes": 4096,
      "ack_timeout_ms": 30000
    }
  }
}
