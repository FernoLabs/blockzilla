# syntax=docker/dockerfile:1.7
ARG BUILD_REVISION=unknown
FROM rust:1.97-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS builder

ARG BUILD_REVISION

RUN test "$(dpkg --print-architecture)" = amd64 \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        clang \
        cmake \
        libclang-dev \
        libssl-dev \
        libudev-dev \
        make \
        pkg-config \
        protobuf-compiler \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# The runtime is intentionally amd64 and requires the same explicit CPU floor as the audit image.
# This produces one portable artifact instead of silently inheriting a builder host's full CPU.
ENV RUSTFLAGS="-C target-feature=+aes,+sse2" \
    CARGO_BUILD_JOBS=2 \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
    CARGO_PROFILE_RELEASE_STRIP=symbols \
    HIVEZILLA_SHRED_BUILD_REVISION=$BUILD_REVISION

WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --locked --release --package hivezilla \
    && cp target/release/hivezilla /tmp/hivezilla

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS runtime

ARG BUILD_REVISION

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        libssl3 \
        libstdc++6 \
        libudev1 \
        zlib1g \
    && groupadd --gid 10001 app \
    && useradd --create-home --uid 10001 --gid 10001 app \
    && install --directory --owner app --group app /data /status \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/hivezilla /usr/local/bin/hivezilla
COPY services/hivezilla/config/ingest-shred-udp.example.json /etc/hivezilla/ingest.json

LABEL org.opencontainers.image.source="https://github.com/FernoLabs/blockzilla"
LABEL org.opencontainers.image.revision="$BUILD_REVISION"

USER app
VOLUME ["/data", "/status"]
ENTRYPOINT ["/usr/local/bin/hivezilla"]
