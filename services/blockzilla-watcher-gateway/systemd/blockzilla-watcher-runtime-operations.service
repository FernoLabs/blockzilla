[Unit]
Description=Blockzilla Rust runtime-operations publisher
After=local-fs.target blockzilla-archive.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Install this as a user unit for the Unix user that owns the observed jobs.
# The required environment file contains one absolute, whitespace-free path:
# BLOCKZILLA_RUNTIME_OPERATIONS_OUTPUT=/served/ui/api/v1/sidecars/runtime-operations/status.json
EnvironmentFile=%h/.config/blockzilla-watcher/runtime-operations.env
ExecStartPre=/usr/bin/test -x /usr/local/bin/blockzilla-watcher-gateway
ExecStartPre=/usr/bin/test -n "${BLOCKZILLA_RUNTIME_OPERATIONS_OUTPUT}"
ExecStart=/usr/local/bin/blockzilla-watcher-gateway publish-runtime-operations --output ${BLOCKZILLA_RUNTIME_OPERATIONS_OUTPUT} --interval-secs 5
Restart=always
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryHigh=128M
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=default.target
