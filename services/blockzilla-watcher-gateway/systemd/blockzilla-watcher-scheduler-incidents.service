[Unit]
Description=Blockzilla Rust private scheduler incident recorder
After=local-fs.target blockzilla-archive.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Install as the scheduler user. Every value is an absolute, whitespace-free
# path; the priority-lease file itself may be absent when no lease is active.
EnvironmentFile=%h/.config/blockzilla-watcher/scheduler-incidents.env
ExecStartPre=/usr/bin/test -x /usr/local/bin/blockzilla-watcher-gateway
ExecStartPre=/usr/bin/test -n "${BLOCKZILLA_BACKFILL_PRIVATE_STATUS}"
ExecStartPre=/usr/bin/test -n "${BLOCKZILLA_SCHEDULER_CONTROL_EVENTS}"
ExecStartPre=/usr/bin/test -n "${BLOCKZILLA_SCHEDULER_PRIORITY_LEASE}"
ExecStartPre=/usr/bin/test -n "${BLOCKZILLA_INCIDENT_STATE}"
ExecStartPre=/usr/bin/test -n "${BLOCKZILLA_INCIDENT_EVENTS}"
ExecStart=/usr/local/bin/blockzilla-watcher-gateway record-scheduler-incidents --backfill-status ${BLOCKZILLA_BACKFILL_PRIVATE_STATUS} --control-events ${BLOCKZILLA_SCHEDULER_CONTROL_EVENTS} --priority-lease ${BLOCKZILLA_SCHEDULER_PRIORITY_LEASE} --state-file ${BLOCKZILLA_INCIDENT_STATE} --events-output ${BLOCKZILLA_INCIDENT_EVENTS} --interval-secs 5 --ring-secs 30 --process-limit 20
Restart=always
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryHigh=128M
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=default.target
