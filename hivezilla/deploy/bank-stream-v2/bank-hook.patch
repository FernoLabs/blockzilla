+#[derive(Clone, Debug)]
+pub struct NativeBankStateV2 {
+    pub slot: u64,
+    pub bank_id: u64,
+    pub parent_slot: u64,
+    pub blockhash: [u8; 32],
+    pub parent_blockhash: [u8; 32],
+    pub block_height: u64,
+    pub last_valid_block_height: Option<u64>,
+    pub observed_at_unix_ms: u64,
+    pub confirmed: bool,
+}
+impl NativeBankStateV2 {
+    pub fn from_bank(bank: &Bank, confirmed: bool) -> Self {
+        let hash = bank.last_blockhash();
+        Self {
+            slot: bank.slot(),
+            bank_id: bank.bank_id(),
+            parent_slot: bank.parent_slot(),
+            blockhash: hash.to_bytes(),
+            parent_blockhash: bank
+                .parent()
+                .map(|p| p.last_blockhash().to_bytes())
+                .unwrap_or([0; 32]),
+            block_height: bank.block_height(),
+            last_valid_block_height: bank.get_blockhash_last_valid_block_height(&hash),
+            observed_at_unix_ms: std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_millis() as u64,
+            confirmed,
+        }
+    }
+}
