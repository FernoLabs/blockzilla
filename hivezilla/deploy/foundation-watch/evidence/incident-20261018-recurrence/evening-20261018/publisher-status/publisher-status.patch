+    struct GatedRemote {
+        inner: Fake,
+        at_head: bool,
+        fail: bool,
+        entered: AtomicBool,
+        active: AtomicBool,
+        release: Mutex<std::sync::mpsc::Receiver<()>>,
+    }
+    impl GatedRemote {
+        fn wait(&self) -> Result<()> {
+            self.active.store(true, Ordering::SeqCst);
+            self.entered.store(true, Ordering::SeqCst);
+            let result = self.release.lock().unwrap().recv_timeout(Duration::from_secs(3));
+            self.active.store(false, Ordering::SeqCst);
+            result.context("test_remote_gate_not_released")?;
+            ensure!(!self.fail, "test_remote_failure");
+            Ok(())
+        }
+    }
+    impl Remote for GatedRemote {
+        fn immutable(&self, key: &str, bytes: &[u8], content_type: &str) -> Result<()> {
+            if !self.at_head && !self.entered.load(Ordering::SeqCst) {
+                self.wait()?;
+            }
+            self.inner.immutable(key, bytes, content_type)
+        }
+        fn head(&self, key: &str, bytes: &[u8]) -> Result<()> {
+            if self.at_head {
+                self.wait()?;
+            }
+            self.inner.head(key, bytes)
+        }
+    }
