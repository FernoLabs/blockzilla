+fn commit_batch_with_liveness(
+    remote: &dyn Remote,
+    state: &Path,
+    cp: &mut Checkpoint,
+    previous: Option<&Chunk>,
+    chunks: &[Chunk],
+    workers: usize,
+    interval: Duration,
+    mut report: impl FnMut(&Checkpoint) -> Result<()>,
+) -> Result<()> {
+    // The coordinator is the only STATUS writer. A heartbeat never advances
+    // durable publication. The scoped worker also includes HEAD and its readback.
+    report(cp).context("publisher_status_write_failed")?;
+    let cancelled = AtomicBool::new(false);
+    let durable = &*cp;
+    let mut report_error = None;
+    let result = std::thread::scope(|scope| -> Result<Checkpoint> {
+        let (send, receive) = sync_channel(1);
+        let cancelled_ref = &cancelled;
+        let handle = scope.spawn(move || {
+            let result = upload_batch(remote, state, durable, previous, chunks, workers, cancelled_ref);
+            let _ = send.send(result);
+        });
+        let result = loop {
+            match receive.recv_timeout(interval) {
+                Ok(result) => break result,
+                Err(RecvTimeoutError::Timeout) => {
+                    if report_error.is_none() {
+                        if let Err(error) = report(durable) {
+                            cancelled.store(true, Ordering::Release);
+                            report_error = Some(error);
+                        }
+                    }
+                }
+                Err(RecvTimeoutError::Disconnected) => break Err(anyhow::anyhow!("publisher_upload_worker_panicked")),
+            }
+        };
+        // Reporting failure cannot detach a request or release the state lock.
+        // Existing requests finish under their existing timeouts; they are not cancelled.
+        if handle.join().is_err() {
+            return Err(anyhow::anyhow!("publisher_upload_worker_panicked"));
+        }
+        result
+    });
+    if let Some(error) = report_error {
+        return Err(error.context("publisher_status_write_failed"));
+    }
+    let next = result?;
+    report(cp).context("publisher_status_write_failed")?;
+    // A HEAD request can finish before a reporting error is observed. In that
+    // case the old checkpoint and durable intent remain for exact replay.
+    finish_batch(state, cp, next)
+}
