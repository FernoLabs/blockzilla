+                        or reservation["kind"] == "retry" and (not 1 <= used <= 3 or v["state"] != "BACKOFF")):
+                    raise ValueError()
+                delay = RECOVERY_DELAYS[used] if used < 3 else RECOVERY_PROBE_SECONDS
+                if v["next_attempt_unix_ms"] < reservation["reserved_unix_ms"] + delay * 1000:
