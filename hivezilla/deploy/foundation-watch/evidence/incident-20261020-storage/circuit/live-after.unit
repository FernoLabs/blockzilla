# /etc/systemd/system/hivezilla-native-cold-storage-20261012-live.service
[Unit]
After=network-online.target
StartLimitIntervalSec=0
[Service]
User=ubuntu
Group=ubuntu
ExecStart="/usr/bin/python3" "/home/ubuntu/live/hivezilla-validator-20260930/releases/native-cloud-retention-20261012/cold_storage.py" "archive" "--output" "/home/ubuntu/live/hivezilla-validator-20260930/compact/direct-agave-processed-live/000000000000000018ddd9a6bb6fc50e-282459" "--bank-output" "/home/ubuntu/live/hivezilla-validator-20260930/compact/bank-v2-live/000000000000000018ddd9a6bb6fc50e-282459" "--capture" "/home/ubuntu/live/hivezilla-validator-20260930/captures/direct-agave-live/000000000000000018ddd9a6bb6fc50e-282459" "--publisher-state" "/home/ubuntu/live/hivezilla-validator-20260930/reports/native-processed-r2-bank-v2/000000000000000018ddd9a6bb6fc50e-282459" "--credentials-file" "/home/ubuntu/live/hivezilla-validator-20260930/config/native-cold-storage.env" "--v1-spool" "/home/ubuntu/live/hivezilla-validator-20260930/stream-relay-spool-bank-v2/000000000000000018ddd9a6bb6fc50e-282459" "--bank-origin-spool" "/home/ubuntu/live/hivezilla-validator-20260930/bank-v2-origin-spool/000000000000000018ddd9a6bb6fc50e-282459" "--keep-seconds" "7200" "--retire" "--follow"
Restart=on-failure
RestartSec=30
Nice=19
CPUQuota=200%
MemoryMax=4G
UMask=0077
KillMode=control-group
TimeoutStopSec=60
StandardOutput=append:/home/ubuntu/live/hivezilla-validator-20260930/reports/bank-v2-recovery-20261012-tools/cold-live.log
StandardError=append:/home/ubuntu/live/hivezilla-validator-20260930/reports/bank-v2-recovery-20261012-tools/cold-live.log
[Install]
