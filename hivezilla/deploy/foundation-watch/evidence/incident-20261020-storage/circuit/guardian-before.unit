# /etc/systemd/system/hivezilla-native-storage-jobs.service
[Unit]
Description=Verify approved native storage jobs and retry safe network faults
After=network-online.target
StartLimitIntervalSec=0
[Service]
User=ubuntu
Group=ubuntu
UMask=0077
ExecStart="/usr/bin/python3" "-B" "/home/ubuntu/live/hivezilla-validator-20260930/releases/storage-protection-20261018-94c2aaca04758c49/storage_jobs.py" "--registry" "/home/ubuntu/live/hivezilla-validator-20260930/config/storage-jobs.json" "--report-dir" "/home/ubuntu/live/hivezilla-validator-20260930/reports/storage-jobs" "--supervise" "--follow" "--interval-seconds" "30"
Restart=on-failure
RestartSec=30
MemoryMax=512M
CPUQuota=20%
Nice=10
IOWeight=10
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths="/home/ubuntu/live/hivezilla-validator-20260930/reports/storage-jobs" "/home/ubuntu/live/hivezilla-validator-20260930/compact/direct-agave-processed-live/000000000000000018df884b2474cf8e-20b258/cold-storage" "/home/ubuntu/live/hivezilla-validator-20260930/compact/direct-agave-processed-live/000000000000000018de229d3fc8a9d9-275b05/cold-storage"
[Install]
WantedBy=multi-user.target

# /etc/systemd/system/hivezilla-native-storage-jobs.service.d/97-approved-source-18ddd9a6.conf
[Service]
ReadWritePaths="/home/ubuntu/live/hivezilla-validator-20260930/compact/direct-agave-processed-live/000000000000000018ddd9a6bb6fc50e-282459/cold-storage"

