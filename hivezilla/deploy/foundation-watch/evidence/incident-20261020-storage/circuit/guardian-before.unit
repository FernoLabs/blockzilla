ExecStart="/usr/bin/python3" "-B" "/home/ubuntu/live/hivezilla-validator-20260930/releases/protocol-retry-20261018-ccc4e4475ec568d1/storage_jobs.py" "--registry" "/home/ubuntu/live/hivezilla-validator-20260930/config/storage-jobs.json" "--report-dir" "/home/ubuntu/live/hivezilla-validator-20260930/reports/storage-jobs" "--supervise" "--follow" "--interval-seconds" "30"

